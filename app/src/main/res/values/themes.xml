<resources>
    <!-- Base app theme for XML Views. Material3 DayNight adapts to light/dark on every API level. -->
    <style name="Theme.WWF" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/wwf_green</item>
        <item name="colorOnPrimary">@color/wwf_white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- SplashScreen compat: works from API 24 up to the latest platform splash API. -->
    <style name="Theme.WWF.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/wwf_green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.WWF</item>
    </style>
</resources>
